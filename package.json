{
  "name": "superwall",
  "version": "0.1.0",
  "description": "The official CLI for managing Superwall from your terminal or coding agent.",
  "keywords": [
    "superwall",
    "paywall",
    "cli",
    "subscriptions",
    "app-store-connect",
    "agent",
    "ios",
    "android"
  ],
  "homepage": "https://github.com/superwall/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superwall/cli.git"
  },
  "bugs": {
    "url": "https://github.com/superwall/cli/issues"
  },
  "author": "Superwall",
  "type": "module",
  "bin": {
    "superwall": "dist/bin.js",
    "sw": "dist/bin.js"
  },
  "files": [
    "dist",
    "skills",
    "prompts",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "dev": "bun bin.ts",
    "test": "tsx --test $(rg --files tests -g '*.test.ts')",
    "link:global": "tsdown && bun link",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.201",
    "ansi-escapes": "^7.3.0",
    "fast-glob": "^3.3.3",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "picocolors": "^1.1.1",
    "react": "^18.3.1",
    "wrap-ansi": "^9.0.2",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/yargs": "^17.0.33",
    "ink-testing-library": "^4.0.0",
    "tsdown": "^0.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
